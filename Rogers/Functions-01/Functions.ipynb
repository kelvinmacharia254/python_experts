   "source": [
    "def sum_num(x,y):\n",
    "    return x+y\n",
    "    return \"Pass. All values are integers\" # dead code\n",
    "\n",
    "print(sum_num(2,3))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
