     "text": [
      "sum of 1,2,3&4 = 10\n",
      "product of 1,2,3&4 = 24\n",
      "average of 1,2,3&4 = 2.5\n"
     ]
    }
   ],
   "source": [
    "def my_sum(*args):\n",
    "    total = 0\n",
    "    for arg in args:\n",
    "        total += arg\n",
    "    return total\n",
    "\n",
    "def my_product(*args):\n",
    "    product = 1\n",
    "    for arg in args:\n",
    "        product *= arg\n",
    "    return product\n",
    "\n",
    "def my_average(*args):\n",
    "    return my_sum(*args) / len(args)\n",
    "\n",
    "print(f'sum of 1,2,3&4 = {my_sum(1,2,3,4)}')\n",
    "print(f'product of 1,2,3&4 = {my_product(1,2,3,4)}')\n",
    "print(f'average of 1,2,3&4 = {my_average(1,2,3,4)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "You can use **kwargs to write a function that can take any number of keyword arguments and perform some operation on them."
